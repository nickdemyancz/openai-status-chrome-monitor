# Editor, OS and local temporary files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~

# Dependencies and local build output (not required by this project)
node_modules/
dist/
build/
*.zip

# Explicitly track the small public installation archives
!downloads/
!downloads/*.zip

# Avoid accidental inclusion of local secrets
.env
.env.*
!.env.example
